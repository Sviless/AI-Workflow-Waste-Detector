# Example environment configuration for AI Workflow Waste Detector.
# Copy this file to ".env" and fill in your own values to prepare
# LLM Enhanced Mode. NONE of this is required to run the app — the default
# Template Engine Mode works with no API key.
#
# Do NOT commit your real .env file or any real API key.

# Your LLM API key (leave unset to run in Template Engine Mode).
LLM_API_KEY=

# Optional hints for a future LLM integration.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
