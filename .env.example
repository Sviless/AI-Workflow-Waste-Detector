# Example environment configuration for AI Workflow Waste Detector.
# Copy this file to ".env" and fill in your own values to enable
# LLM Enhanced Mode. NONE of this is required to run the app — the default
# Template Engine Mode works with no API key.
#
# Do NOT commit your real .env file or any real API key.

# Your API key (leave unset to run in Template Engine Mode).
# For Google Gemini, paste your Gemini API key. Any of these names works:
#   LLM_API_KEY, GEMINI_API_KEY, GOOGLE_API_KEY
GEMINI_API_KEY=

# Optional: LLM provider and model. Defaults target Google Gemini.
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash
